# Copy to .env and fill in. Loaded by pydantic-settings (app/settings.py).

# Needed only by the LLM planner. Without it the app falls back to the rule planner.
ANTHROPIC_API_KEY=

# Model used to fill the QueryPlan.
PLANNER_MODEL=claude-sonnet-5-5

# ClinicalTrials.gov API v2.
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2/studies

# Hard cap on how many studies one request will pull.
MAX_STUDIES=2000

# Where fetched API pages are cached on disk.
CACHE_DIR=.cache
