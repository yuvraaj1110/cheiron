# Copy to .env and fill in. Loaded by pydantic-settings (app/settings.py).

# Needed only by the LLM planner. Without it the app falls back to the rule planner.
OPENAI_API_KEY=sk-...

# Model used to fill the QueryPlan (OpenAI structured outputs, temperature 0).
PLANNER_MODEL=gpt-4.1-mini

# ClinicalTrials.gov API v2.
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2/studies

# Hard cap on how many studies one request will pull. Pages of 1000 come
# back in well under a second, so 10000 keeps even breast cancer (17k
# matches) quick, and the response is cached on disk afterwards.
MAX_STUDIES=10000

# Where fetched API pages are cached on disk.
CACHE_DIR=.cache
